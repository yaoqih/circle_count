{
  "name": "circle-label",
  "version": "0.1.0",
  "private": true,
  "author": "huyaoqi",
  "description": "Desktop YOLO annotation tool for fiber connector end-face images",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build": "npm run build:app",
    "dist": "npm run build:app && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build:app && electron-builder --config electron-builder.yml --win nsis portable",
    "dist:dir": "npm run build:app && electron-builder --config electron-builder.yml --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
